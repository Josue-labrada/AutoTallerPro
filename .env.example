# Copia este archivo como `.env` y cambia los valores. NUNCA subas el `.env` real a Git.

POSTGRES_USER=autotaller
POSTGRES_PASSWORD=cambia_esta_contrasena_db
POSTGRES_DB=autotaller

# Debe coincidir con los datos de arriba.
DATABASE_URL=postgres://autotaller:cambia_esta_contrasena_db@localhost:5433/autotaller

# Almacenamiento de fotos (MinIO). La consola web queda en http://localhost:9001
MINIO_ROOT_USER=autotaller_minio
MINIO_ROOT_PASSWORD=cambia_esta_contrasena_minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_BUCKET=autotaller-fotos

PORT=3000
