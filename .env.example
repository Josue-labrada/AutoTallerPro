# Copia este archivo como `.env` (o deja que iniciar.command / iniciar.bat lo cree con contraseñas aleatorias).
# =====================================================================
#  AutoTaller Pro - configuración local
#  Este archivo tiene contraseñas: NO lo subas a Git ni lo compartas.
# =====================================================================

# ---------------------------------------------------------------------
#  1) POSTGRES  -  la base de datos
#     Dirección:   localhost:5433
#     Usuario:     el valor de POSTGRES_USER
#     Contraseña:  el valor de POSTGRES_PASSWORD
#     (Los usa el backend. Solo los necesitas tú si entras con una
#      herramienta de bases de datos.)
# ---------------------------------------------------------------------
POSTGRES_USER=autotaller
POSTGRES_PASSWORD=cambia_esta_contrasena_db
POSTGRES_DB=autotaller
# Debe coincidir con los tres datos de arriba (usuario, contraseña y base).
DATABASE_URL=postgres://autotaller:cambia_esta_contrasena_db@localhost:5433/autotaller

# ---------------------------------------------------------------------
#  2) MINIO  -  el almacén de fotos de los daños
#     Consola web: http://localhost:9001
#     Usuario:     el valor de MINIO_ROOT_USER
#     Contraseña:  el valor de MINIO_ROOT_PASSWORD
# ---------------------------------------------------------------------
MINIO_ROOT_USER=autotaller_minio
MINIO_ROOT_PASSWORD=cambia_esta_contrasena_minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_BUCKET=autotaller-fotos

# ---------------------------------------------------------------------
#  3) AUTOTALLER PRO  -  la aplicación web
#     Dirección:   http://localhost:5173
#     Usuario:     el valor de ADMIN_EMAIL (es un correo)
#     Contraseña:  el valor de ADMIN_PASSWORD
#     (Es el primer administrador; desde el menú "Usuarios" creas a los
#      trabajadores. Los clientes se registran solos.)
# ---------------------------------------------------------------------
ADMIN_EMAIL=admin@autotaller.local
ADMIN_NAME=Administrador
ADMIN_PASSWORD=cambia_esta_contrasena_admin

# ---------------------------------------------------------------------
#  4) BACKEND  -  ajustes del servidor (no son contraseñas)
# ---------------------------------------------------------------------
PORT=3000
# Direcciones desde las que el navegador puede usar la API (separadas por coma).
# En producción: la dirección pública de la aplicación.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
