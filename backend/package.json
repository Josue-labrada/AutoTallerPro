{
  "name": "autotaller-pro-backend",
  "version": "1.0.0",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch --env-file=../.env src/app/server.ts",
    "build": "tsc",
    "start": "node --env-file=../.env dist/app/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file=../.env src/config/migrate.ts",
    "seed": "tsx --env-file=../.env src/config/seed.ts",
    "create-admin": "tsx --env-file=../.env src/config/createAdmin.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage"
  },
  "description": "API de AutoTaller Pro",
  "private": "true",
  "type": "module",
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "minio": "^8.0.7",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
